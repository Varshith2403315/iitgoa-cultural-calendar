rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }

    match /events/{eventId} {
      allow read: if true;

      allow create: if signedIn() && role() == 'gensec';

      allow delete: if signedIn() && role() == 'gensec';

      allow update: if signedIn() && (
        role() == 'gensec' ||
        (
          role() == 'originals' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoLinks'])
        )
      );
    }

    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
