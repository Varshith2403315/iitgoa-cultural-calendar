rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }

    match /events/{eventId} {
      function appendsHttpsPhotoLink() {
        let oldLinks = resource.data.photoLinks;
        let newLinks = request.resource.data.photoLinks;
        return oldLinks is list &&
          newLinks is list &&
          newLinks.size() == oldLinks.size() + 1 &&
          newLinks.hasAll(oldLinks) &&
          newLinks[oldLinks.size()] is string &&
          newLinks[oldLinks.size()].matches('^https://.+');
      }

      allow read: if true;

      allow create: if signedIn() && role() == 'gensec';

      allow delete: if signedIn() && role() == 'gensec';

      allow update: if signedIn() && (
        role() == 'gensec' ||
        (
          role() == 'originals' &&
          resource.data.eventEnd is timestamp &&
          resource.data.eventEnd < request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoLinks']) &&
          appendsHttpsPhotoLink()
        )
      );
    }

    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
