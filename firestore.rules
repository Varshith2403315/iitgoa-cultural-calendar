rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleData() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }

    function role() {
      return roleData().role;
    }

    // Display name stored on the role document (falls back to the role string).
    function myName() {
      return roleData().get('name', roleData().role);
    }

    function isGensec() { return signedIn() && role() == 'gensec'; }
    function isClub() { return signedIn() && role() == 'club'; }
    function isManager() { return signedIn() && role() == 'manager'; }

    // Dean view-only link: an anonymous sign-in that presented the current secret key.
    // Resetting the key in /secrets/dean cancels every old link.
    function isViewer() {
      let session = /databases/$(database)/documents/viewerSessions/$(request.auth.uid);
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous' &&
        exists(session) &&
        get(session).data.key == get(/databases/$(database)/documents/secrets/dean).data.key;
    }

    function stampedByMe(field) {
      return request.resource.data.uid == request.auth.uid &&
        request.resource.data.by == myName() &&
        request.resource.data[field] == request.time;
    }

    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    match /events/{eventId} {
      function appendsHttpsPhotoLink() {
        let oldLinks = resource.data.photoLinks;
        let newLinks = request.resource.data.photoLinks;
        return oldLinks is list &&
          newLinks is list &&
          newLinks.size() == oldLinks.size() + 1 &&
          newLinks.hasAll(oldLinks) &&
          newLinks[oldLinks.size()] is string &&
          newLinks[oldLinks.size()].matches('^https://.+');
      }

      allow read: if true;

      allow create: if isGensec();

      allow delete: if isGensec();

      allow update: if isGensec() || (
        role() == 'originals' &&
        resource.data.eventEnd is timestamp &&
        resource.data.eventEnd < request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoLinks']) &&
        appendsHttpsPhotoLink()
      ) || (
        // Clubs may edit everything except the date, and must sign the change.
        isClub() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'time', 'venue', 'category', 'desc', 'notes', 'eventEnd', 'descUpdatedBy', 'descUpdatedAt']) &&
        // Old separate notes get merged into About, so clubs may only clear that field.
        request.resource.data.get('notes', '') in [resource.data.get('notes', ''), ''] &&
        shortString(request.resource.data.title, 140) && request.resource.data.title.size() > 0 &&
        shortString(request.resource.data.venue, 140) && request.resource.data.venue.size() > 0 &&
        request.resource.data.category in ['dance', 'music', 'drama', 'art', 'literary', 'fest', 'other'] &&
        request.resource.data.time is string && request.resource.data.time.matches('^([0-9]{2}:[0-9]{2})?$') &&
        (request.resource.data.eventEnd == null || request.resource.data.eventEnd is timestamp) &&
        shortString(request.resource.data.desc, 3000) &&
        request.resource.data.desc.size() > 0 &&
        request.resource.data.descUpdatedBy == myName() &&
        request.resource.data.descUpdatedAt == request.time
      );
    }

    // Append-only history of event edits. oldNotes/newNotes hold the changed fields before and after.
    match /noteLogs/{logId} {
      allow read: if isGensec() || isClub() || isViewer();
      allow create: if (isGensec() || isClub()) &&
        request.resource.data.keys().hasOnly(['eventId', 'eventTitle', 'eventDate', 'oldNotes', 'newNotes', 'by', 'uid', 'at']) &&
        request.resource.data.eventId is string &&
        shortString(request.resource.data.oldNotes, 3000) &&
        shortString(request.resource.data.newNotes, 3000) &&
        stampedByMe('at');
      allow update, delete: if false;
    }

    // Club suggestions (date changes, event changes, concerns).
    match /suggestions/{suggestionId} {
      allow read: if isGensec() || isClub() || isViewer();
      allow create: if isClub() &&
        request.resource.data.keys().hasOnly(['eventId', 'eventTitle', 'eventDate', 'type', 'proposedDate', 'message', 'by', 'uid', 'status', 'createdAt']) &&
        request.resource.data.type in ['date', 'new', 'event', 'other'] &&
        request.resource.data.status == 'open' &&
        shortString(request.resource.data.message, 1000) &&
        request.resource.data.message.size() > 0 &&
        stampedByMe('createdAt');
      allow update: if isGensec() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt']) &&
        request.resource.data.status in ['open', 'accepted', 'declined'];
      allow delete: if isGensec();
    }

    // Bills: Google Drive links filed under an event. Only GenSec, managers and the Dean link can see them.
    match /bills/{billId} {
      allow read: if isGensec() || isManager() || isViewer();
      allow create: if isManager() &&
        request.resource.data.keys().hasOnly(['eventId', 'eventTitle', 'eventDate', 'label', 'link', 'kind', 'amount', 'by', 'uid', 'createdAt']) &&
        shortString(request.resource.data.label, 140) &&
        request.resource.data.link is string &&
        request.resource.data.link.matches('^https://(drive|docs)[.]google[.]com/.+') &&
        request.resource.data.kind in ['PDF', 'Image'] &&
        (request.resource.data.amount == null || (request.resource.data.amount is number && request.resource.data.amount >= 0)) &&
        stampedByMe('createdAt');
      allow update: if false;
      allow delete: if isGensec();
    }

    // Secret key behind the Dean's view-only link. Only the General Secretary can read or reset it.
    match /secrets/{secretId} {
      allow read, write: if isGensec();
    }

    match /viewerSessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.auth.token.firebase.sign_in_provider == 'anonymous' &&
        request.resource.data.keys().hasOnly(['key', 'createdAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.key == get(/databases/$(database)/documents/secrets/dean).data.key;
      allow delete: if false;
    }

    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
